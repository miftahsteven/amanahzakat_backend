datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. AUTHENTICATION & ACCESS CONTROL (ACL)
// ==========================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String
  namaLengkap   String
  nomorHp       String?
  nip           String?
  isActive      Boolean   @default(true)
  isOtpVerified Boolean   @default(false)

  userRoles     UserRole[]
  otpTokens     OtpToken[]
  auditTrails   AuditTrail[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Role {
  id              String           @id @default(cuid())
  kodeRole        String           @unique // e.g. SUPER_ADMIN, MANAJER_KEUANGAN, VERIFIKATOR, AMIL
  namaRole        String
  deskripsi       String?
  isSystem        Boolean          @default(false)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Permission {
  id              String           @id @default(cuid())
  kodePermission  String           @unique // e.g. penerimaan.read, penerimaan.create, penyaluran.approve, user.manage
  namaPermission  String
  modul           String           // e.g. Auth, User, Penerimaan, Penyaluran, Keuangan, Master

  rolePermissions RolePermission[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model OtpToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String   // Dummy "00000"
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditTrail {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
}

// ==========================================
// 2. DOMAIN ZIS: MUZAKKI & PENERIMAAN
// ==========================================

model Muzakki {
  id               String                 @id @default(cuid())
  nomor            String                 @unique // e.g. MZK-2026-00001
  nama             String
  tipe             String                 // Perorangan, Korporat, UPZ
  nikAtauNpwp      String
  hp               String
  email            String
  alamat           String
  totalSetoran     Float                  @default(0)
  transaksiCount   Int                    @default(0)
  tanggalBergabung String
  penerimaanList   TransaksiPenerimaan[]

  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model TransaksiPenerimaan {
  id             String    @id @default(cuid())
  noKwitansi     String    @unique // e.g. KWT/2026/08/001
  tanggal        String
  muzakkiId      String
  muzakki        Muzakki   @relation(fields: [muzakkiId], references: [id])
  jenisZis       String    // Zakat Maal, Zakat Profesi, Fitrah, Infak, Shodaqoh
  nominal        Float
  kanal          String    // Transfer Bank BSI, QRIS, Cash
  rekeningTujuan String
  status         String    // Terverifikasi, Menunggu Verifikasi
  catatan        String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ==========================================
// 3. DOMAIN ZIS: MUSTAHIK & PENYALURAN 8 ASNAF
// ==========================================

model Mustahik {
  id                   String                @id @default(cuid())
  nik                  String                @unique
  nama                 String
  kategoriAsnaf        String                // Fakir, Miskin, Amil, Mualaf, Riqab, Gharim, Fisabilillah, Ibnus Sabil
  hp                   String
  alamat               String
  pekerjaan            String
  jumlahTanggungan     Int
  penghasilanBulanan   Float
  rekeningBank         String
  statusSurvei         String                // Terverifikasi, Perlu Survei
  skorKelayakan        Int                   @default(80)
  totalBantuanDiterima Float                 @default(0)
  penyaluranList       TransaksiPenyaluran[]

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model ProgramZis {
  id                String                @id @default(cuid())
  nama              String
  pilar             String                // Pendidikan, Kesehatan, Ekonomi, Dakwah, Kemanusiaan
  paguAnggaran      Float
  terpakai          Float                 @default(0)
  targetPenerima    Int
  realisasiPenerima Int                   @default(0)
  status            String                @default("Berjalan")
  penanggungJawab   String
  penyaluranList    TransaksiPenyaluran[]

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
}

model TransaksiPenyaluran {
  id               String      @id @default(cuid())
  noPenyaluran     String      @unique // e.g. SLR/2026/08/001
  tanggal          String
  mustahikId       String
  mustahik         Mustahik    @relation(fields: [mustahikId], references: [id])
  asnaf            String      // Fakir, Miskin, Amil, Mualaf, etc.
  programId        String
  program          ProgramZis  @relation(fields: [programId], references: [id])
  nominal          Float
  status           String      // Siap Bayar, Sudah Tersalurkan
  metodePembayaran String
  rekeningTujuan   String
  keterangan       String
  potonganAmil     Float       @default(0)
  danaMustahik     Float       @default(0)

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

// ==========================================
// 4. KEUANGAN, COA, & PSAK 109
// ==========================================

model AccountCoA {
  id        String   @id @default(cuid())
  kode      String   @unique
  nama      String
  tipe      String   // Aset, Dana Zakat, Dana Infak, Dana Amil, Penerimaan, Penyaluran
  grup      String   // AKTIFA, PENDIRIAN, PENERIMAAN, PENYALURAN
  saldo     Float    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JurnalEntry {
  id          String   @id @default(cuid())
  noJurnal    String   @unique // e.g. JRN/2026/08/001
  tanggal     String
  keterangan  String
  debitKode   String
  debitNama   String
  kreditKode  String
  kreditNama  String
  nominal     Float
  status      String   @default("Posted")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FormSimba {
  id         String   @id @default(cuid())
  kodeForm   String   @unique
  namaForm   String
  status     String   @default("Draft")
  itemCount  Int      @default(0)
  totalNilai Float    @default(0)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ==========================================
// 5. MITRA, UPZ & AMIL
// ==========================================

model MitraPenyalur {
  id                String   @id @default(cuid())
  nama              String
  bentukLembaga     String
  noMou             String   @unique
  masaKerjasama     String
  picKontak         String
  hpPic             String
  totalPenyaluran   Float    @default(0)
  statusLaporanLpj  String   @default("Terverifikasi")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model UpzCabang {
  id                 String   @id @default(cuid())
  kodeUpz            String   @unique
  nama               String
  kategori           String
  totalPenghimpunan  Float    @default(0)
  totalPenyaluran    Float    @default(0)
  hakPengelolaanPct  Float    @default(10)
  statusKepatuhan    String   @default("Patuh")

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AmilKaryawan {
  id                  String   @id @default(cuid())
  nip                 String   @unique
  nama                String
  jabatan             String
  divisi              String
  gajiPokok           Float
  tunjanganAmil       Float
  potonganZakat       Float
  keikutsertaanPayroll Boolean  @default(true)
  statusKerja         String   @default("Tetap")

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
