datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. AUTHENTICATION & ACCESS CONTROL (ACL)
// ==========================================

model User {
  id            String  @id @default(cuid())
  email         String  @unique
  username      String  @unique
  passwordHash  String
  namaLengkap   String
  nomorHp       String?
  nip           String?
  isActive      Boolean @default(true)
  isOtpVerified Boolean @default(false)

  userRoles   UserRole[]
  otpTokens   OtpToken[]
  auditTrails AuditTrail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id        String  @id @default(cuid())
  kodeRole  String  @unique // e.g. SUPER_ADMIN, MANAJER_KEUANGAN, VERIFIKATOR, AMIL
  namaRole  String
  deskripsi String?
  isSystem  Boolean @default(false)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Modul {
  id        String  @id @default(cuid())
  kodeModul String  @unique
  namaModul String
  urutan    Int     @default(0)
  isActive  Boolean @default(true)
  menus     Menu[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Menu {
  id              String       @id @default(cuid())
  modulId         String
  modul           Modul        @relation(fields: [modulId], references: [id], onDelete: Cascade)
  kodeMenu        String       @unique
  namaMenu        String
  kodeTampil      String
  icon            String?
  urutan          Int          @default(0)
  tampilDiSidebar Boolean      @default(true)
  tampilDiHeader  Boolean      @default(false)
  isActive        Boolean      @default(true)
  permissions     Permission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id             String @id @default(cuid())
  kodePermission String @unique
  namaPermission String
  aksi           String
  menuId         String
  menu           Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([menuId, aksi])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model OtpToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String // Dummy "00000"
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditTrail {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
}

// ==========================================
// 2. DOMAIN ZIS: MUZAKKI & PENERIMAAN ERP
// ==========================================

model Muzakki {
  id               String                @id @default(cuid())
  nomor            String                @unique // e.g. MZK-2026-00001
  nama             String
  tipe             String                @default("Perorangan") // Perorangan, Korporat, UPZ
  nikAtauNpwp      String
  hp               String
  email            String
  alamat           String
  totalSetoran     Float                 @default(0)
  transaksiCount   Int                   @default(0)
  tanggalBergabung String
  penerimaanList   TransaksiPenerimaan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TransaksiPenerimaan {
  id             String  @id @default(cuid())
  noKwitansi     String  @unique // e.g. KWT/2026/08/001
  noSbmz         String? // e.g. SBMZ/2026/08/ASK004182
  tanggal        String
  muzakkiId      String
  muzakki        Muzakki @relation(fields: [muzakkiId], references: [id])
  jenisZis       String // Zakat Maal, Zakat Profesi, Fitrah, Infak, Shodaqoh, Wakaf
  programNama    String? // Judul Program Kebaikan
  nominal        Float
  kanal          String // BSI Virtual Account, Mandiri, QRIS, Cash, Transfer Manual
  rekeningTujuan String
  status         String // Terverifikasi, Menunggu Verifikasi
  catatan        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 3. DOMAIN ZIS: MUSTAHIK & PENYALURAN 8 ASNAF
// ==========================================

model Mustahik {
  id                   String                @id @default(cuid())
  nik                  String                @unique
  nama                 String
  kategoriAsnaf        String // Fakir, Miskin, Amil, Mualaf, Riqab, Gharim, Fisabilillah, Ibnus Sabil
  hp                   String
  alamat               String
  pekerjaan            String
  jumlahTanggungan     Int
  penghasilanBulanan   Float
  rekeningBank         String
  statusSurvei         String // Terverifikasi, Perlu Survei
  skorKelayakan        Int                   @default(80)
  totalBantuanDiterima Float                 @default(0)
  penyaluranList       TransaksiPenyaluran[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProgramZis {
  id                String                @id @default(cuid())
  nama              String
  pilar             String // Pendidikan, Kesehatan, Ekonomi, Dakwah, Kemanusiaan
  paguAnggaran      Float
  terpakai          Float                 @default(0)
  targetPenerima    Int
  realisasiPenerima Int                   @default(0)
  status            String                @default("Berjalan")
  penanggungJawab   String
  penyaluranList    TransaksiPenyaluran[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TransaksiPenyaluran {
  id               String     @id @default(cuid())
  noPenyaluran     String     @unique // e.g. SLR/2026/08/001
  tanggal          String
  mustahikId       String
  mustahik         Mustahik   @relation(fields: [mustahikId], references: [id])
  asnaf            String // Fakir, Miskin, Amil, Mualaf, etc.
  programId        String
  program          ProgramZis @relation(fields: [programId], references: [id])
  nominal          Float
  status           String // Siap Bayar, Sudah Tersalurkan
  metodePembayaran String
  rekeningTujuan   String
  keterangan       String
  potonganAmil     Float      @default(0)
  danaMustahik     Float      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 4. KEUANGAN, COA, & PSAK 109
// ==========================================

model AccountCoA {
  id    String @id @default(cuid())
  kode  String @unique
  nama  String
  tipe  String // Aset, Dana Zakat, Dana Infak, Dana Amil, Penerimaan, Penyaluran
  grup  String // AKTIFA, PENDIRIAN, PENERIMAAN, PENYALURAN
  saldo Float  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JurnalEntry {
  id         String @id @default(cuid())
  noJurnal   String @unique // e.g. JRN/2026/08/001
  tanggal    String
  keterangan String
  debitKode  String
  debitNama  String
  kreditKode String
  kreditNama String
  nominal    Float
  status     String @default("Posted")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FormSimba {
  id         String @id @default(cuid())
  kodeForm   String @unique
  namaForm   String
  status     String @default("Draft")
  itemCount  Int    @default(0)
  totalNilai Float  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 5. MITRA, UPZ & AMIL
// ==========================================

model MitraPenyalur {
  id               String @id @default(cuid())
  nama             String
  bentukLembaga    String
  noMou            String @unique
  masaKerjasama    String
  picKontak        String
  hpPic            String
  totalPenyaluran  Float  @default(0)
  statusLaporanLpj String @default("Terverifikasi")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UpzCabang {
  id                String @id @default(cuid())
  kodeUpz           String @unique
  nama              String
  kategori          String
  totalPenghimpunan Float  @default(0)
  totalPenyaluran   Float  @default(0)
  hakPengelolaanPct Float  @default(10)
  statusKepatuhan   String @default("Patuh")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AmilKaryawan {
  id                   String  @id @default(cuid())
  nip                  String  @unique
  nama                 String
  jabatan              String
  divisi               String
  gajiPokok            Float
  tunjanganAmil        Float
  potonganZakat        Float
  keikutsertaanPayroll Boolean @default(true)
  statusKerja          String  @default("Tetap")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 6. PUBLIC WEB: PROGRAM, KAMPANYE & KONTEN
// ==========================================

model Campaign {
  id           Int     @id @default(autoincrement())
  slug         String  @unique
  nama         String
  program      String
  lokasi       String
  target       Float
  terkumpul    Float   @default(0)
  donaturCount Int     @default(0)
  tenggat      String
  ringkas      String
  cerita       String
  imageUrl     String
  rincian      Json
  kabar        Json
  donaturList  Json
  status       String  @default("Berjalan") // "Berjalan", "Tercapai"
  isFeatured   Boolean @default(false)

  donasiList DonasiWeb[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KabarPenyaluran {
  id       Int    @id @default(autoincrement())
  slug     String @unique
  judul    String
  program  String
  kampanye String
  lokasi   String
  tgl      String
  nominal  Float
  penerima Int
  asnaf    String
  mitra    String
  status   String @default("Terbit")
  ringkas  String
  isi      String
  rincian  Json
  imageUrl String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ImpactData {
  id                 String @id @default("default-impact")
  metrics            Json
  fundAllocations    Json
  beneficiaryStories Json
  annualReports      Json

  updatedAt DateTime @updatedAt
}

model FaqItem {
  id              String @id @default(cuid())
  category        String
  question        String
  answer          String
  sourceReference String
  urutan          Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DonasiWeb {
  id              String    @id @default(cuid())
  transactionId   String    @unique // e.g. TR-ZIS-2026-0819-XXXX
  campaignId      Int?
  campaign        Campaign? @relation(fields: [campaignId], references: [id])
  campaignSlug    String?
  campaignTitle   String
  fundType        String // Zakat Maal, Zakat Profesi, Infak, Wakaf, Qurban
  amount          Float
  uniqueCode      Int       @default(0)
  totalAmount     Float
  paymentMethod   String // VIRTUAL_ACCOUNT, QRIS, BANK_TRANSFER
  paymentProvider String // BSI, BCA, MANDIRI, QRIS
  paymentCode     String
  qrPayload       String?
  donorName       String
  donorEmail      String?
  donorPhone      String?
  isAnonymous     Boolean   @default(false)
  message         String?
  status          String    @default("PENDING") // PENDING, PAID, EXPIRED, FAILED
  expiredAt       DateTime
  paidAt          DateTime?
  sbmzNumber      String?
  noKwitansi      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MuzakkiAuth {
  id             String  @id @default(cuid())
  memberId       String  @unique // e.g. MZK-2026-0819
  email          String  @unique
  passwordHash   String
  nama           String
  phone          String
  alamat         String?
  pekerjaan      String?
  npwp           String?
  nik            String?
  namaNpwp       String?
  alamatKpp      String?
  isNpwpVerified Boolean @default(false)

  sbmzDocs       SbmzDoc[]
  recurringPlans RecurringZis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SbmzDoc {
  id              String       @id @default(cuid())
  sbmzNumber      String       @unique // e.g. SBMZ/2026/07/ASK004182
  transactionCode String
  tahunPajak      Int
  category        String
  programTitle    String
  nominal         Float
  terbilang       String
  tanggalTerbit   String
  muzakkiAuthId   String?
  muzakkiAuth     MuzakkiAuth? @relation(fields: [muzakkiAuthId], references: [id])
  muzakkiNama     String
  muzakkiNpwp     String
  muzakkiNik      String?
  muzakkiAlamat   String
  lembagaNama     String       @default("Lembaga Amil Zakat Nasional AmanahZakat Peduli")
  lembagaIzin     String       @default("Keputusan Menteri Agama RI No. 892 Tahun 2019")
  lembagaNpwp     String       @default("02.456.789.1-012.000")
  legalBasis      String       @default("UU No. 23 Tahun 2011 Pasal 22 & UU No. 36 Tahun 2008 Pasal 9 ayat (1) huruf g")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecurringZis {
  id                String      @id @default(cuid())
  muzakkiAuthId     String
  muzakkiAuth       MuzakkiAuth @relation(fields: [muzakkiAuthId], references: [id], onDelete: Cascade)
  title             String
  category          String
  nominal           Float
  frequency         String      @default("Bulanan")
  deductDay         Int         @default(25)
  paymentMethod     String
  status            String      @default("Aktif") // Aktif, Dijeda, Dibatalkan
  nextDeductionDate String
  totalDonated      Float       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PengajuanBantuan {
  id                      String  @id @default(cuid())
  submissionNumber        String  @unique // e.g. PB-2026-0819
  nik                     String
  namaLengkap             String
  asnafCategory           String
  telepon                 String
  email                   String?
  alamatLengkap           String
  provinsi                String
  kotaKabupaten           String
  pekerjaan               String
  penghasilanBulanan      Float
  jumlahTanggungan        Int
  kondisiTempatTinggal    String
  programBantuanDimohon   String
  estimasiBiayaDibutuhkan Float
  status                  String  @default("Menunggu Verifikasi")
  surveiNotes             String?
  tahapanProses           Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
