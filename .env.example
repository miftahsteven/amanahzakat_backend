PORT=5005
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change_me_refresh_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Origin situs publik (webpublic) — dipakai untuk URL di QR BSZ
PUBLIC_SITE_URL=http://localhost:3000

# HMAC secret untuk signed URL verifikasi BSZ (QR petugas pajak).
# Wajib diganti di production; jangan sama dengan secret yang bocor.
BSZ_VERIFY_SECRET=change_me_bsz_verify_hmac_in_production
