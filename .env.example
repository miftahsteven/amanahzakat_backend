PORT=5005
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change_me_refresh_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Origin situs publik (webpublic) — dipakai untuk URL di QR BSZ & Midtrans Callbacks
PUBLIC_SITE_URL=https://amanahzakat.id
WEB_PUBLIC_URL=https://amanahzakat.id

# HMAC secret untuk signed URL verifikasi BSZ (QR petugas pajak).
# Wajib diganti di production; jangan sama dengan secret yang bocor.
BSZ_VERIFY_SECRET=change_me_bsz_verify_hmac_in_production

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=change_me_with_server_key
MIDTRANS_CLIENT_KEY=change_me_with_client_key
MIDTRANS_IS_PRODUCTION=true

